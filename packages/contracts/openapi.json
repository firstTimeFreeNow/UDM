  "components": {
    "schemas": {
      "Answer": {
        "type": "string",
        "enum": [
          "○",
          "△",
          "×",
          ""
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "participant",
          "admin"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m_[a-f0-9-]{36}$"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "required"
        ]
      },
      "Slot": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} ([01]\\d|2[0-3]):(00|30)$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(00|30)$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "judgment": {
            "type": "string",
            "enum": [
              "開催可能",
              "必須未達",
              "人数不足",
              "人数調整"
            ]
          },
          "hasAnswers": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "date",
          "time",
          "count",
          "judgment"
        ]
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "weekId": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "maxItems": 12
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            },
            "maxItems": 54
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/components/schemas/Answer"
              }
            }
          },
          "confirmed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} ([01]\\d|2[0-3]):(00|30)$",
            "nullable": true
          },
          "minParticipants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "maxParticipants": {
            "type": "integer",
            "enum": [
              8
            ]
          }
        },
        "required": [
          "weekId",
          "members",
          "slots",
          "answers",
          "confirmed",
          "minParticipants",
          "maxParticipants"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} ([01]\\d|2[0-3]):(00|30)$"
          },
          "before": {
            "$ref": "#/components/schemas/Answer"
          },
          "answer": {
            "$ref": "#/components/schemas/Answer"
          }
        },
        "required": [
          "slot",
          "before",
          "answer"
        ]
      },
      "HistoryItem": {
        "type": "object",
        "properties": {
          "weekId": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confirmed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} ([01]\\d|2[0-3]):(00|30)$",
            "nullable": true
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "weekId",
          "confirmed",
          "status"
        ]
      },
      "History": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "maxItems": 12
          },
          "nextOffset": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextOffset"
        ]
      },
      "InternalPath": {
        "type": "string",
        "pattern": "^/UDM/(?:[a-zA-Z0-9_-]+/)*$",
        "maxLength": 240
      },
      "SharedLink": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{4,32}$"
          },
          "path": {
            "$ref": "#/components/schemas/InternalPath"
          },
          "active": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "active",
          "updatedAt"
        ]
      },
      "LinkList": {
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SharedLink"
            },
            "maxItems": 200
          }
        },
        "required": [
          "links"
