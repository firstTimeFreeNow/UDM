# Copy to .env.local and fill in your Firebase Web app configuration.
# NEXT_PUBLIC values are included in browser builds; do not put passwords, ID tokens or private keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Production Apps Script /exec URL. Do not use the isolated probe endpoint.
NEXT_PUBLIC_AF_API_URL=

# Optional push notifications: Firebase Cloud Messaging Web Push public key and sender ID.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# New BFF origin. When set, all UDM API calls use this origin; failures never fall back to Apps Script.
# Leave empty only during migration before the BFF is deployed.
NEXT_PUBLIC_UDM_API_URL=

# Local Go BFF: http://127.0.0.1:8080 is accepted only by next dev.
