{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "noEmit": true,
    "types": [
      "google-apps-script"
    ],
    "lib": [
      "ES2020"
    ],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
