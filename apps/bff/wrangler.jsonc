{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udm-bff",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "UDM_FIREBASE_PROJECT_ID": "udm-2319d",
    "UDM_ALLOWED_ORIGINS": "https://firsttimefreenow.github.io",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SERVICE_CACHE", "class_name": "ScheduleCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScheduleCoordinator"] },
  ],
  "observability": { "enabled": false },
}
