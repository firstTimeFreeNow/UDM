{
  "name": "udm",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @udm/web dev",
    "build": "pnpm --filter @udm/web build",
    "typecheck": "pnpm --filter @udm/web typecheck",
    "test:release": "node --test .github/scripts/*.test.mjs",
    "test:planner": "node --test tests/*.test.mjs",
    "test:afetiria": "node --test tests/apps-script/*.test.mjs tests/sheets-transport/*.test.mjs",
    "check:apps-script": "node tools/apps-script/deploy.mjs validate",
    "test:bff": "node --test tests/bff/*.test.mjs",
    "dev:bff": "pnpm --filter @udm/bff dev",
    "build:bff": "pnpm --filter @udm/bff build",
    "test": "pnpm run test:release && pnpm run test:planner && pnpm run test:afetiria && pnpm run test:bff",
    "deploy:bff": "node tools/deploy-bff.mjs",
    "deploy:apps-script": "pnpm --filter @udm/apps-script deploy"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "typescript": "5.9.3",
    "jose": "^6.2.17"
  }
}
